FROM debian:bookworm
#
# Build szip 
#
ENV DEBIAN_FRONTEND=noninteractive
RUN useradd --create-home builduser
RUN apt-get update && apt-get install -y --no-install-recommends vim-tiny bash ca-certificates curl wget git make gcc less && rm -rf /var/lib/apt/lists/*

USER builduser
WORKDIR /home/builduser

RUN wget http://www.compressconsult.com/szip/sz112b_src.tar.gz
RUN tar xvfz sz112b_src.tar.gz
RUN make szip

CMD [ "tail", "-f", "/dev/null" ]
