FROM python:3.13-alpine3.22
# Set Environment variables
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Add System Tools
RUN apk add --no-cache curl jq git openssl unzip gettext bash pwgen grep bind-tools busybox-extras mariadb-client
# Add s3cmd
RUN pip install --no-cache-dir s3cmd
# Add kubectl
RUN curl -fsSL --retry 3 "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl && chmod +x /usr/local/bin/kubectl
#
RUN adduser -u 1000 -D appuser
WORKDIR /home/appuser
USER appuser
ENV PYTHONUNBUFFERED=0
